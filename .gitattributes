# Normalize line endings across OSes.
# The repository stores text as LF; each OS checks out its native endings.
* text=auto

# Config dotfiles — keep LF everywhere (avoids the LF->CRLF warning)
.gitattributes text eol=lf
.gitignore     text eol=lf

# Web/source text — store as LF, always (keeps diffs clean on every OS)
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# OS-specific scripts (for anything added later) — must keep native endings
*.sh   text eol=lf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets — never touch line endings
*.woff2 binary
*.woff  binary
*.ttf   binary
*.otf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
